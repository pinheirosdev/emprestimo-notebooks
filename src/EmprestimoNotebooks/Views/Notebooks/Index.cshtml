@model IReadOnlyList<EmprestimoNotebooks.Models.NotebookResumo>

@{
    ViewData["Title"] = "Inventário de notebooks";
    var disponiveis = Model.Count(notebook => !notebook.Emprestado && !notebook.EmManutencao);
    var emprestados = Model.Count(notebook => notebook.Emprestado);
}

<div class="titulo-acoes">
    <h1>Inventário de notebooks</h1>
    <a class="botao" asp-action="Cadastrar">Cadastrar notebook</a>
</div>

@if (TempData["Mensagem"] is string mensagem)
{
    <p class="mensagem" role="status">@mensagem</p>
}

<dl class="resumo">
    <div>
        <dt>Total</dt>
        <dd>@Model.Count</dd>
    </div>
    <div>
        <dt>Disponíveis</dt>
        <dd>@disponiveis</dd>
    </div>
    <div>
        <dt>Emprestados</dt>
        <dd>@emprestados</dd>
    </div>
    <div>
        <dt>Em manutenção</dt>
        <dd>@(Model.Count - disponiveis - emprestados)</dd>
    </div>
</dl>

@if (Model.Count == 0)
{
    <p class="vazio">Nenhum notebook cadastrado.</p>
}
else
{
    <table class="inventario tabela-notebooks">
        <caption class="visualmente-oculto">Notebooks cadastrados</caption>
        <thead>
            <tr>
                <th scope="col">Patrimônio</th>
                <th scope="col">Marca e modelo</th>
                <th scope="col">Situação</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var notebook in Model)
            {
                <tr>
                    <th scope="row">@notebook.Patrimonio</th>
                    <td>@notebook.Marca @notebook.Modelo</td>
                    <td>
                        @if (notebook.Emprestado)
                        {
                            <span class="situacao emprestado">Emprestado</span>
                        }
                        else if (notebook.EmManutencao)
                        {
                            <span class="situacao manutencao">Em manutenção</span>
                        }
                        else
                        {
                            <span class="situacao disponivel">Disponível</span>
                        }
                    </td>
                    <td>
                        <div class="acoes-tabela">
                            @if (notebook.EmprestimoAbertoId is int emprestimoId)
                            {
                                <a class="acao-tabela" asp-controller="Emprestimos" asp-action="Devolver" asp-route-id="@emprestimoId" aria-label="Devolver notebook @notebook.Patrimonio">Devolver</a>
                            }
                            else if (!notebook.EmManutencao)
                            {
                                <a class="acao-tabela" asp-controller="Emprestimos" asp-action="Retirar" asp-route-id="@notebook.Id" aria-label="Retirar notebook @notebook.Patrimonio">Retirar</a>
                            }
                            <a class="acao-tabela" asp-action="Editar" asp-route-id="@notebook.Id" aria-label="Editar notebook @notebook.Patrimonio">Editar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
