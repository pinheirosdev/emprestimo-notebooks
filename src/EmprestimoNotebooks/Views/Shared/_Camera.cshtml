<fieldset class="camera" data-camera aria-describedby="orientacao-camera erro-foto">
    <legend>Foto do aluno</legend>
    <p class="camera-orientacao" id="orientacao-camera">Tire a foto com o aluno de frente para a câmera.</p>
    <input id="Foto" name="Foto" type="file" hidden>
    @Html.ValidationMessage("Foto", new { id = "erro-foto" })
    <noscript>Ative o JavaScript para tirar a foto.</noscript>
    <video muted playsinline hidden aria-label="Imagem da câmera"></video>
    <img alt="Prévia da foto do aluno" hidden>
    <div class="camera-acoes">
        <button class="botao botao-secundario" type="button" data-abrir-camera hidden>Abrir câmera</button>
        <button class="botao botao-secundario" type="button" data-tirar-foto hidden>Tirar foto</button>
    </div>
    <p class="camera-status" role="status"></p>
</fieldset>
