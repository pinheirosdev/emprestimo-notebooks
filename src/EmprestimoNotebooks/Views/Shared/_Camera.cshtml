@model string

@{
    var fotoNotebook = Model == "FotoNotebook";
    var orientacao = $"orientacao-{Model}";
    var erro = $"erro-{Model}";
}

<fieldset class="camera" data-camera aria-describedby="@orientacao @erro">
    <legend>@(fotoNotebook ? "Foto do notebook" : "Foto do aluno")</legend>
    <p class="camera-orientacao" id="@orientacao">@(fotoNotebook ? "Enquadre o notebook para registrar o estado do equipamento." : "Tire a foto com o aluno de frente para a câmera.")</p>
    <input id="@Model" name="@Model" type="file" hidden>
    @Html.ValidationMessage(Model, new { id = erro })
    <noscript>Ative o JavaScript para tirar a foto.</noscript>
    <video muted playsinline hidden aria-label="Imagem da câmera"></video>
    <img alt="@(fotoNotebook ? "Prévia da foto do notebook" : "Prévia da foto do aluno")" hidden>
    <div class="camera-acoes">
        <button class="botao botao-secundario" type="button" data-abrir-camera hidden>Abrir câmera</button>
        <button class="botao botao-secundario" type="button" data-tirar-foto hidden>Tirar foto</button>
        <button class="botao botao-secundario" type="button" data-fechar-camera hidden>Fechar câmera</button>
    </div>
    <p class="camera-status" role="status"></p>
</fieldset>
