@model EmprestimoNotebooks.Models.AlunoFormulario

@{
    ViewData["Title"] = "Cadastrar aluno";
}

<h1>Cadastrar aluno</h1>

<form class="formulario" asp-action="Cadastrar" method="post" enctype="multipart/form-data">
    <div class="campo">
        <label asp-for="NomeCompleto"></label>
        <input asp-for="NomeCompleto" autocomplete="off" required aria-describedby="erro-nome">
        <span asp-validation-for="NomeCompleto" id="erro-nome"></span>
    </div>

    <div class="campo">
        <label asp-for="Matricula"></label>
        <input asp-for="Matricula" autocomplete="off" spellcheck="false" required aria-describedby="erro-matricula">
        <span asp-validation-for="Matricula" id="erro-matricula"></span>
    </div>

    <div class="campo">
        <label asp-for="Turma"></label>
        <input asp-for="Turma" autocomplete="off" required aria-describedby="erro-turma">
        <span asp-validation-for="Turma" id="erro-turma"></span>
    </div>

    <fieldset class="camera" data-camera aria-describedby="orientacao-camera erro-foto">
        <legend>Foto do aluno</legend>
        <p class="camera-orientacao" id="orientacao-camera">Tire a foto com o aluno de frente para a câmera.</p>
        <input asp-for="Foto" type="file" hidden>
        <span asp-validation-for="Foto" id="erro-foto"></span>
        <noscript>Ative o JavaScript para tirar a foto.</noscript>
        <video muted playsinline hidden aria-label="Imagem da câmera"></video>
        <img alt="Prévia da foto do aluno" hidden>
        <div class="camera-acoes">
            <button class="botao botao-secundario" type="button" data-abrir-camera hidden>Abrir câmera</button>
            <button class="botao botao-secundario" type="button" data-tirar-foto hidden>Tirar foto</button>
        </div>
        <p class="camera-status" role="status"></p>
    </fieldset>

    <div class="formulario-acoes">
        <button class="botao" type="submit" disabled>Salvar aluno</button>
        <a class="botao botao-secundario" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/camera.js" asp-append-version="true" defer></script>
}
