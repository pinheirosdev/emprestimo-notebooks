@model IReadOnlyList<EmprestimoNotebooks.Models.AlunoResumo>

@{
    ViewData["Title"] = "Alunos";
    var busca = ViewData["Busca"] as string;
}

<div class="titulo-acoes">
    <h1>Alunos</h1>
    <a class="botao" asp-action="Cadastrar">Cadastrar aluno</a>
</div>

@if (TempData["Mensagem"] is string mensagem)
{
    <p class="mensagem" role="status">@mensagem</p>
}

<form class="busca-alunos" asp-action="Index" method="get" role="search">
    <div class="campo">
        <label for="busca">Nome ou matrícula</label>
        <input id="busca" name="busca" type="search" value="@busca">
    </div>
    <button class="botao botao-secundario" type="submit">Buscar</button>
    @if (!string.IsNullOrWhiteSpace(busca))
    {
        <a class="acao-tabela" asp-action="Index">Limpar busca</a>
    }
</form>

@if (Model.Count == 0)
{
    <p class="vazio">@(string.IsNullOrWhiteSpace(busca) ? "Nenhum aluno cadastrado." : "Nenhum aluno encontrado.")</p>
}
else
{
    <table class="inventario tabela-alunos">
        <caption class="visualmente-oculto">Alunos cadastrados</caption>
        <thead>
            <tr>
                <th scope="col">Nome completo</th>
                <th scope="col">Matrícula</th>
                <th scope="col">Turma</th>
                <th scope="col">Foto</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var aluno in Model)
            {
                <tr>
                    <th scope="row">@aluno.NomeCompleto</th>
                    <td>@aluno.Matricula</td>
                    <td>@aluno.Turma</td>
                    <td><a class="acao-tabela" asp-action="Foto" asp-route-id="@aluno.Id" aria-label="Ver foto de @aluno.NomeCompleto">Ver foto</a></td>
                </tr>
            }
        </tbody>
    </table>
}
